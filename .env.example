# Finance V2 only. Never point the V2 binary at the preserved legacy database.
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/moneykeeper_v2
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
TEST_EMAIL=you@example.com
TEST_PASSWORD=replace-with-test-account-password
PUBLIC_URL=https://v2-development.example.invalid
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# Required stable Finance V2 key version and two independent 256-bit keys.
# The deliberately invalid placeholders below make startup fail until replaced.
FINANCE_V2_ENCRYPTION_KEY_ID=replace-with-key-version
FINANCE_V2_ENCRYPTION_KEY=INVALID_BASE64_REPLACE_WITH_32_RANDOM_BYTES
FINANCE_V2_WEBHOOK_DIGEST_KEY=INVALID_BASE64_REPLACE_WITH_DIFFERENT_32_RANDOM_BYTES

# Operational callback base used when registering Monobank webhooks. The
# credential-bearing path suffix is generated by Banking and must not be logged.
MONOBANK_WEBHOOK_BASE_URL=https://v2-development.example.invalid

# Gmail OAuth browser callback. All three values are startup-required.
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REDIRECT_URI=https://v2-development.example.invalid/oauth/gmail/callback
GMAIL_OAUTH_SUCCESS_URL=https://frontend.example.invalid/settings/connections
GMAIL_OAUTH_FAILURE_URL=https://frontend.example.invalid/settings/connections

# Candidate defaults are a 1-second worker poll interval and 30-second Mail,
# Recurring, and reference-data leases. Retry/backoff state is durable in each
# owning schema. These settings are code-reviewed and are not environment
# overrides; changing them requires a new rehearsed candidate.
