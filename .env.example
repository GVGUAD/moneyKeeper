DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moneykeeper
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
TEST_EMAIL=you@example.com
TEST_PASSWORD=your-password
PUBLIC_URL=https://your-app.fly.dev
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# Gmail OAuth browser callback. GMAIL_REDIRECT_URI defaults to
# ${PUBLIC_URL}/oauth/gmail/callback when omitted.
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=https://your-app.fly.dev/oauth/gmail/callback
GMAIL_OAUTH_SUCCESS_URL=https://your-frontend.example/settings/connections
GMAIL_OAUTH_FAILURE_URL=https://your-frontend.example/settings/connections

# Comma-separated key-id:base64 entries. Every key must decode to exactly 32
# random bytes; keep old keys here until rotation has completed.
TOKEN_ENCRYPTION_KEYS=v1:replace-with-base64-encoded-32-byte-key
TOKEN_ENCRYPTION_PRIMARY_KEY_ID=v1
TOKEN_ENCRYPTION_WRITE_MODE=dual_write
