  "components": {
    "schemas": {
      "AccountDetailsDto": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "interest_rate",
              "compounding_period",
              "type"
            ],
            "properties": {
              "compounding_period": {
                "type": "string"
              },
              "interest_rate": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "savings"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "counterparty",
              "direction",
              "type"
            ],
            "properties": {
              "counterparty": {
                "type": "string"
              },
              "direction": {
                "type": "string"
              },
              "due_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interest_rate": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "loan"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "broker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "investment"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "binance"
                ]
              }
            }
          }
        ]
      },
      "AccountResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "account_type",
          "currency",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "account_type": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "currency": {
            "type": "string"
          },
          "details": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AccountDetailsDto"
              }
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BalanceResponse": {
        "type": "object",
        "required": [
          "account_id",
          "balance",
          "currency"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "balance": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "CategoryResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ConnectMonobankRequest": {
        "type": "object",
        "required": [
          "account_id",
          "token",
          "external_account_id"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "external_account_id": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "CreateAccountRequest": {
        "type": "object",
        "required": [
          "name",
          "account_type",
          "currency"
        ],
        "properties": {
          "account_type": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "details": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AccountDetailsDto"
              }
            ]
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateCategoryRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateTransactionRequest": {
        "type": "object",
        "required": [
          "amount",
          "currency",
          "kind",
          "transacted_at"
        ],
        "properties": {
          "amount": {
            "type": "string"
          },
          "category_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "currency": {
            "type": "string"
          },
          "details": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TransactionDetailsDto"
              }
            ]
          },
          "kind": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "transacted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MonoAccountResponse": {
        "type": "object",
        "required": [
          "id",
          "currency_code",
          "balance",
          "account_type"
        ],
        "properties": {
