    "/monobank/client-info": {
      "get": {
        "tags": [
          "monobank"
        ],
        "summary": "GET /monobank/client-info  (requires X-Token header)",
        "operationId": "get_client_info",
        "parameters": [
          {
            "name": "x-token",
            "in": "header",
            "description": "Monobank API token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "list of monobank accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MonoAccountResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "missing X-Token header"
          },
          "401": {
            "description": "unauthorized"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
